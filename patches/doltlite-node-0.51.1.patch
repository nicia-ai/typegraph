 // Throws a SQLite error as a JS Error.
 inline void ThrowSQLiteError(Napi::Env env, sqlite3* db, const char* context = nullptr) {
-  std::string msg;
-  if (context) { msg += context; msg += ": "; }
-  msg += sqlite3_errmsg(db);
-  Napi::Error::New(env, msg).ThrowAsJavaScriptException();
+  const int code = sqlite3_extended_errcode(db);
+  auto error = Napi::Error::New(env, sqlite3_errmsg(db));
+  error.Set("code", "ERR_SQLITE_ERROR");
+  error.Set("errcode", Napi::Number::New(env, code));
+  error.Set("errstr", sqlite3_errstr(code));
+  if (context) error.Set("operation", context);
+  error.ThrowAsJavaScriptException();
 }
diff --git a/test/errors.test.cjs b/test/errors.test.cjs
new file mode 100644
index 0000000..8e59041
--- /dev/null
+++ b/test/errors.test.cjs
@@ -0,0 +1,64 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { mkdtempSync, rmSync } = require('node:fs');
+const { tmpdir } = require('node:os');
+const path = require('node:path');
+const { DatabaseSync } = require('..');
+
+function expectSqliteError(run, errcode, message) {
+  assert.throws(run, error => {
+    assert.equal(error.code, 'ERR_SQLITE_ERROR');
+    assert.equal(error.errcode, errcode);
+    assert.equal(typeof error.errstr, 'string');
+    assert.equal(error.message, message);
+    return true;
+  });
+}
+
+test('preserves engine messages and extended codes from every statement entry point', () => {
+  const db = new DatabaseSync(':memory:');
+  try {
+    db.exec('CREATE TABLE p(id TEXT PRIMARY KEY, name TEXT UNIQUE, required TEXT NOT NULL); INSERT INTO p VALUES (\'one\',\'one\',\'yes\')');
+    const sql = "INSERT INTO p VALUES ('one','other','yes') RETURNING id";
+    expectSqliteError(() => db.exec(sql), 1555, 'UNIQUE constraint failed: p.id');
+    for (const method of ['run', 'get', 'all', 'iterate']) {
+      const statement = db.prepare(sql);
+      expectSqliteError(() => [...(method === 'iterate' ? statement.iterate() : [statement[method]()])], 1555, 'UNIQUE constraint failed: p.id');
+      expectSqliteError(() => statement[method](), 1555, 'UNIQUE constraint failed: p.id');
+    }
+    expectSqliteError(() => db.exec("INSERT INTO p VALUES ('two','one','yes')"), 2067, 'UNIQUE constraint failed: p.name');
+    expectSqliteError(() => db.exec("INSERT INTO p VALUES ('two','two',NULL)"), 1299, 'NOT NULL constraint failed: p.required');
+    expectSqliteError(() => db.prepare('SELECT * FROM missing_table'), 1, 'no such table: missing_table');
+  } finally { db.close(); }
+});
+
+test('distinguishes writer contention from stale read snapshots', () => {
+  const directory = mkdtempSync(path.join(tmpdir(), 'doltlite-errors-'));
+  const filename = path.join(directory, 'test.db');
+  const first = new DatabaseSync(filename);
+  const second = new DatabaseSync(filename);
+  try {
+    first.exec('PRAGMA busy_timeout=0; CREATE TABLE p(id INTEGER PRIMARY KEY, value INTEGER); INSERT INTO p VALUES (1,0)');
+    second.exec('PRAGMA busy_timeout=0');
+    first.exec('BEGIN IMMEDIATE');
+    expectSqliteError(() => second.exec('UPDATE p SET value=1'), 5, 'database is locked');
+    first.exec('ROLLBACK; BEGIN');
+    first.prepare('SELECT * FROM p').all();
+    second.exec('UPDATE p SET value=1');
+    expectSqliteError(() => first.prepare('UPDATE p SET value=2').run(), 517, 'database is locked');
+    first.exec('ROLLBACK');
+  } finally {
+    if (first.inTransaction) first.exec('ROLLBACK');
+    if (second.inTransaction) second.exec('ROLLBACK');
+    first.close(); second.close(); rmSync(directory, {recursive:true,force:true});
+  }
+});
+
+test('bundles vec1 distance functions and SQLite math functions', () => {
+  const db = new DatabaseSync(':memory:');
+  try {
+    const zero = new Uint8Array(new Float32Array([0, 0]).buffer);
+    const other = new Uint8Array(new Float32Array([3, 4]).buffer);
+    assert.equal(db.prepare('SELECT sqrt(vec1_l2_distance(?,?)) AS value').get(zero, other).value, 5);
+  } finally { db.close(); }
+});
