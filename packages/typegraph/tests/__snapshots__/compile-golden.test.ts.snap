        WHERE graph_id = $1 AND run_id = $2
      )
      SELECT node_id, node_kind, component_id, component_kind, component_size
      FROM memberships
      
      ORDER BY component_id COLLATE "C", component_kind COLLATE "C", node_id COLLATE "C", node_kind COLLATE "C"
