      recursive_cte AS (
        -- Base case: starting nodes
        SELECT n0.id AS p_id, n0.kind AS p_kind, n0.props AS p_props, n0.version AS p_version, n0.valid_from AS p_valid_from, n0.valid_to AS p_valid_to, n0.created_at AS p_created_at, n0.updated_at AS p_updated_at, n0.deleted_at AS p_deleted_at, n0.id AS report_id, n0.kind AS report_kind, n0.props AS report_props, n0.version AS report_version, n0.valid_from AS report_valid_from, n0.valid_to AS report_valid_to, n0.created_at AS report_created_at, n0.updated_at AS report_updated_at, n0.deleted_at AS report_deleted_at, 0 AS depth, '|' || replace(replace(n0.id, '%', '%25'), '|', '%7C') || '|' AS path
        FROM "typegraph_recorded_nodes" n0
        WHERE n0.graph_id = ? AND n0.kind = ? AND (n0.deleted_at IS NULL) AND n0.recorded_from <= ? AND ? < n0.recorded_to AND json_extract(props, '$."name"') = ?

        UNION ALL

        -- Recursive case: follow edges
        
        SELECT r.p_id AS p_id, r.p_kind AS p_kind, r.p_props AS p_props, r.p_version AS p_version, r.p_valid_from AS p_valid_from, r.p_valid_to AS p_valid_to, r.p_created_at AS p_created_at, r.p_updated_at AS p_updated_at, r.p_deleted_at AS p_deleted_at, n.id AS report_id, n.kind AS report_kind, n.props AS report_props, n.version AS report_version, n.valid_from AS report_valid_from, n.valid_to AS report_valid_to, n.created_at AS report_created_at, n.updated_at AS report_updated_at, n.deleted_at AS report_deleted_at, r.depth + 1 AS depth, r.path || replace(replace(n.id, '%', '%25'), '|', '%7C') || '|' AS path
        FROM recursive_cte r
        
        CROSS JOIN "typegraph_recorded_edges" e
        JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
          AND n.id = e.to_id
          AND n.kind = e.to_kind
        WHERE e.from_id = r.report_id AND e.graph_id = ? AND n.kind = ? AND (e.deleted_at IS NULL) AND e.recorded_from <= ? AND ? < e.recorded_to AND (n.deleted_at IS NULL) AND n.recorded_from <= ? AND ? < n.recorded_to AND r.depth < ? AND INSTR(r.path, '|' || replace(replace(n.id, '%', '%25'), '|', '%7C') || '|') = 0 AND e.kind = ? AND e.to_kind = ? AND e.from_kind = ?
      
      )
     SELECT p_id AS "p_id", p_kind AS "p_kind", p_props AS "p_props", p_version AS "p_version", p_valid_from AS "p_valid_from", p_valid_to AS "p_valid_to", p_created_at AS "p_created_at", p_updated_at AS "p_updated_at", p_deleted_at AS "p_deleted_at", report_id AS "report_id", report_kind AS "report_kind", report_props AS "report_props", report_version AS "report_version", report_valid_from AS "report_valid_from", report_valid_to AS "report_valid_to", report_created_at AS "report_created_at", report_updated_at AS "report_updated_at", report_deleted_at AS "report_deleted_at", depth AS "level", path AS "route", NULL AS "e_id", NULL AS "e_kind", NULL AS "e_from_id", NULL AS "e_to_id", NULL AS "e_props", NULL AS "e_valid_from", NULL AS "e_valid_to", NULL AS "e_created_at", NULL AS "e_updated_at", NULL AS "e_deleted_at" FROM recursive_cte AS "__tg_recursive_result_0" WHERE depth >= ?",
