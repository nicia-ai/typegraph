exports[`compile-golden: store statement builders > neighbors (createNeighborRead) > asOf / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "compile_golden",
    "knows",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "Person",
    "person-1",
  ],
  "sql": "SELECT e.graph_id AS "edge_graph_id", e.id AS "edge_id", e.kind AS "edge_kind", e.from_kind AS "edge_from_kind", e.from_id AS "edge_from_id", e.to_kind AS "edge_to_kind", e.to_id AS "edge_to_id", e.props AS "edge_props", e.valid_from AS "edge_valid_from", e.valid_to AS "edge_valid_to", e.created_at AS "edge_created_at", e.updated_at AS "edge_updated_at", e.deleted_at AS "edge_deleted_at", n.graph_id AS "node_graph_id", n.id AS "node_id", n.kind AS "node_kind", n.props AS "node_props", n.version AS "node_version", n.valid_from AS "node_valid_from", n.valid_to AS "node_valid_to", n.created_at AS "node_created_at", n.updated_at AS "node_updated_at", n.deleted_at AS "node_deleted_at", e.id AS typegraph_neighbor_order FROM "typegraph_edges" e JOIN "typegraph_nodes" n ON n.kind = e.to_kind AND n.id = e.to_id WHERE e.graph_id = $1 AND n.graph_id = $2 AND e.kind = $3 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $4) AND (e.valid_to IS NULL OR e.valid_to > $5) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $6) AND (n.valid_to IS NULL OR n.valid_to > $7) AND e.from_kind = $8 AND e.from_id = $9 ORDER BY CASE WHEN e.id IS NULL THEN 1 ELSE 0 END ASC, e.id ASC, e.id ASC",
}
`;

