      SELECT cte_p.p_id AS p_id, cte_p.p_kind AS p_kind, n.id AS o_id, n.kind AS o_kind, n.props AS o_props
      FROM cte_p
      
      JOIN "typegraph_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = ? AND n.kind = ? AND 1=1 AND 1=1 AND e.kind = ? AND e.to_kind = ? AND e.from_kind = ?
    
      )
     SELECT json_extract(cte_o.o_props, '$."name"') AS "orgName", COUNT(cte_p.p_id) AS "employeeCount" FROM cte_p INNER JOIN cte_o ON cte_o.p_id = cte_p.p_id AND cte_o.p_kind = cte_p.p_kind GROUP BY json_extract(cte_o.o_props, '$."name"')",
}
`;

