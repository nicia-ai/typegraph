exports[`compile-golden: store statement builders > algorithm degree and weighted expansion > shortestPath working-table path, asOf / postgres 1`] = `
[
  {
    "params": [],
    "sql": "
    CREATE TEMP TABLE "typegraph_iterative_<id>" (
        graph_id TEXT NOT NULL,
        run_id TEXT NOT NULL,
        side TEXT NOT NULL,
        node_id TEXT NOT NULL,
        node_kind TEXT NOT NULL,
        depth INTEGER NOT NULL,
        predecessor_id TEXT,
        predecessor_kind TEXT,
        meeting_depth INTEGER,
        PRIMARY KEY (graph_id, run_id, side, node_kind, node_id)
      )
  ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "forward",
      "compile_golden_algorithm_statements",
      "person-1",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
    ],
    "sql": "
      INSERT INTO "typegraph_iterative_<id>"
        (graph_id, run_id, side, node_id, node_kind, depth,
         predecessor_id, predecessor_kind)
      SELECT $1, $2, $3, n.id, n.kind, 0, NULL, NULL
      FROM "typegraph_nodes" n
      WHERE n.graph_id = $4
        AND n.id = $5
        AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $6) AND (n.valid_to IS NULL OR n.valid_to > $7)
      ON CONFLICT (graph_id, run_id, side, node_kind, node_id) DO NOTHING
      RETURNING node_id, node_kind
    ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "reverse",
      "compile_golden_algorithm_statements",
      "person-2",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
    ],
    "sql": "
      INSERT INTO "typegraph_iterative_<id>"
        (graph_id, run_id, side, node_id, node_kind, depth,
         predecessor_id, predecessor_kind)
      SELECT $1, $2, $3, n.id, n.kind, 0, NULL, NULL
      FROM "typegraph_nodes" n
      WHERE n.graph_id = $4
        AND n.id = $5
        AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $6) AND (n.valid_to IS NULL OR n.valid_to > $7)
      ON CONFLICT (graph_id, run_id, side, node_kind, node_id) DO NOTHING
      RETURNING node_id, node_kind
    ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "forward",
      1,
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "reverse",
      "compile_golden_algorithm_statements",
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "forward",
      0,
      "knows",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
      "compile_golden_algorithm_statements",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "forward",
    ],
    "sql": "
        INSERT INTO "typegraph_iterative_<id>"
          (graph_id, run_id, side, node_id, node_kind, depth,
           predecessor_id, predecessor_kind, meeting_depth)
        SELECT
          $1, $2, $3,
          ranked.target_id, ranked.target_kind, $4,
          ranked.source_id, ranked.source_kind,
          (
            SELECT opposite.depth
            FROM "typegraph_iterative_<id>" opposite
            WHERE opposite.graph_id = $5
              AND opposite.run_id = $6
              AND opposite.side = $7
              AND opposite.node_id = ranked.target_id
              AND opposite.node_kind = ranked.target_kind
          )
        FROM (
          SELECT expanded.*,
            ROW_NUMBER() OVER (
              PARTITION BY expanded.target_kind COLLATE "C", expanded.target_id COLLATE "C"
              ORDER BY expanded.source_id COLLATE "C", expanded.source_kind COLLATE "C"
            ) AS candidate_rank
