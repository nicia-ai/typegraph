      0.85,
      "compile_golden_rank",
      "<generated-id-1>",
      "compile_golden_rank",
      "<generated-id-1>",
    ],
    "sql": "
    UPDATE "typegraph_iterative_<id>"
    SET "next_score" = personalization * (
      ? + ? * (
        SELECT COALESCE(SUM(dangling."score"), 0.0)
        FROM "typegraph_iterative_<id>" dangling
        WHERE dangling.graph_id = ?
          AND dangling.run_id = ?
          AND dangling.out_weight = 0.0
      )
    )
    WHERE graph_id = ? AND run_id = ?
  ",
  },
  {
    "params": [
      "compile_golden_rank",
      "compile_golden_rank",
      "<generated-id-1>",
      "rates",
      7,
      7,
      "compile_golden_rank",
      "<generated-id-1>",
      0.85,
      "compile_golden_rank",
      "<generated-id-1>",
    ],
    "sql": "
    WITH scoped_edges AS (
      SELECT
        expanded.target_id,
        expanded.target_kind,
        expanded.source_score,
        expanded.source_out_weight,
        1.0 AS transition_weight
      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, w."score" AS source_score, w.out_weight AS source_out_weight, e.to_id AS target_id, e.to_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = ? WHERE w.graph_id = ? AND w.run_id = ? AND e.kind = ? AND (e.deleted_at IS NULL) AND e.recorded_from <= ? AND ? < e.recorded_to) expanded
      JOIN "typegraph_iterative_<id>" scoped_target
        ON scoped_target.graph_id = ?
        AND scoped_target.run_id = ?
        AND scoped_target.node_id = expanded.target_id
        AND scoped_target.node_kind = expanded.target_kind
      WHERE expanded.source_out_weight > 0.0
    ), contributions AS (
      SELECT
        target_id,
        target_kind,
        SUM(source_score * transition_weight / source_out_weight) AS score
      FROM scoped_edges
      GROUP BY target_id, target_kind
    )
    UPDATE "typegraph_iterative_<id>" AS target
    SET "next_score" = target."next_score" + ? * contributions.score
    FROM contributions
    WHERE target.graph_id = ?
      AND target.run_id = ?
      AND target.node_id = contributions.target_id
      AND target.node_kind = contributions.target_kind
  ",
  },
  {
    "params": [
      "compile_golden_rank",
      "<generated-id-1>",
    ],
    "sql": "
