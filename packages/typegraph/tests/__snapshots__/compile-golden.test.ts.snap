        ON "identity_peer".seed_kind = cte_p.p_kind
       AND "identity_peer".seed_id = cte_p.p_id
    
        CROSS JOIN "typegraph_recorded_edges" e
        JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
          AND n.id = e.to_id
          AND n.kind = e.to_kind
        WHERE 
        COALESCE("identity_peer".id, cte_p.p_id) = e.from_id
        AND COALESCE("identity_peer".kind, cte_p.p_kind) = e.from_kind
       AND e.graph_id = ? AND n.kind = ? AND (e.deleted_at IS NULL) AND e.recorded_from <= ? AND ? < e.recorded_to AND (n.deleted_at IS NULL) AND n.recorded_from <= ? AND ? < n.recorded_to AND e.kind = ? AND e.to_kind = ?
      
      )
