exports[`compile-golden: metadata, dates, fragments, recursive outputs, aliases > recursive traversal with default depth alias and minHops > asOf / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
