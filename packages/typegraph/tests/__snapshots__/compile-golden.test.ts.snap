    ],
    "sql": "
    WITH candidates AS (
      SELECT
        expanded.target_id,
        expanded.target_kind,
        expanded.source_label_id AS label_id,
        expanded.source_label_kind AS label_kind
      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, w.label_id AS source_label_id, w.label_kind AS source_label_kind, e.to_id AS target_id, e.to_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = $1 WHERE 
      w.graph_id = $2
      AND w.run_id = $3
      AND w.improved_round = $4
     AND e.kind = $5 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $6) AND (e.valid_to IS NULL OR e.valid_to > $7) UNION ALL SELECT w.node_id AS source_id, w.node_kind AS source_kind, w.label_id AS source_label_id, w.label_kind AS source_label_kind, e.from_id AS target_id, e.from_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_edges" e ON e.to_id = w.node_id AND e.to_kind = w.node_kind AND e.graph_id = $8 WHERE 
      w.graph_id = $9
      AND w.run_id = $10
      AND w.improved_round = $11
     AND e.kind = $12 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $13) AND (e.valid_to IS NULL OR e.valid_to > $14)) expanded
      JOIN "typegraph_iterative_<id>" scoped_target
        ON scoped_target.graph_id = $15
        AND scoped_target.run_id = $16
        AND scoped_target.node_id = expanded.target_id
        AND scoped_target.node_kind = expanded.target_kind
    ), ranked AS (
      SELECT
        target_id,
        target_kind,
        label_id,
        label_kind,
        ROW_NUMBER() OVER (
          PARTITION BY source.target_kind COLLATE "C", source.target_id COLLATE "C"
          ORDER BY source.label_id COLLATE "C", source.label_kind COLLATE "C"
        ) AS candidate_rank
      FROM candidates source
    )
    UPDATE "typegraph_iterative_<id>" AS target
    SET next_label_id = ranked.label_id,
        next_label_kind = ranked.label_kind
    FROM ranked
    WHERE target.graph_id = $17
      AND target.run_id = $18
      AND target.node_id = ranked.target_id
      AND target.node_kind = ranked.target_kind
      AND ranked.candidate_rank = 1
      AND (
        ranked.label_id COLLATE "C" < target.next_label_id COLLATE "C"
        OR (
          ranked.label_id COLLATE "C" = target.next_label_id COLLATE "C"
