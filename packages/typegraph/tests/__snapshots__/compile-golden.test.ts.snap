exports[`compile-golden: metadata, dates, fragments, recursive outputs, aliases > date predicates with canonical operands > edge date property / postgres 1`] = `
{
  "params": [
    "compile_golden_schedule",
    "Person",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "compile_golden_schedule",
    "Meeting",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "2024-06-01T12:00:00.000Z",
    "attends",
    "Meeting",
    "Person",
  ],
  "sql": "WITH 
    cte_p AS NOT MATERIALIZED (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4)
    )
  , 
      cte_m AS NOT MATERIALIZED (
        
      SELECT cte_p.*, e.id AS a_id, e.kind AS a_kind, e.from_id AS a_from_id, e.to_id AS a_to_id, e.props AS a_props, e.valid_from AS a_valid_from, e.valid_to AS a_valid_to, e.created_at AS a_created_at, e.updated_at AS a_updated_at, e.deleted_at AS a_deleted_at, n.id AS m_id, n.kind AS m_kind, n.props AS m_props, n.version AS m_version, n.valid_from AS m_valid_from, n.valid_to AS m_valid_to, n.created_at AS m_created_at, n.updated_at AS m_updated_at, n.deleted_at AS m_deleted_at
      FROM cte_p
      
      JOIN "typegraph_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = $5 AND n.kind = $6 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $7) AND (e.valid_to IS NULL OR e.valid_to > $8) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $9) AND (n.valid_to IS NULL OR n.valid_to > $10) AND (e.props #>> ARRAY['since'])::timestamptz < $11 AND e.kind = $12 AND e.to_kind = $13 AND e.from_kind = $14
    
      )
     SELECT cte_m.p_id AS "p_id", cte_m.p_kind AS "p_kind", cte_m.p_props AS "p_props", cte_m.p_version AS "p_version", cte_m.p_valid_from AS "p_valid_from", cte_m.p_valid_to AS "p_valid_to", cte_m.p_created_at AS "p_created_at", cte_m.p_updated_at AS "p_updated_at", cte_m.p_deleted_at AS "p_deleted_at", cte_m.a_id AS "a_id", cte_m.a_kind AS "a_kind", cte_m.a_from_id AS "a_from_id", cte_m.a_to_id AS "a_to_id", cte_m.a_props AS "a_props", cte_m.a_valid_from AS "a_valid_from", cte_m.a_valid_to AS "a_valid_to", cte_m.a_created_at AS "a_created_at", cte_m.a_updated_at AS "a_updated_at", cte_m.a_deleted_at AS "a_deleted_at", cte_m.m_id AS "m_id", cte_m.m_kind AS "m_kind", cte_m.m_props AS "m_props", cte_m.m_version AS "m_version", cte_m.m_valid_from AS "m_valid_from", cte_m.m_valid_to AS "m_valid_to", cte_m.m_created_at AS "m_created_at", cte_m.m_updated_at AS "m_updated_at", cte_m.m_deleted_at AS "m_deleted_at" FROM cte_m",
}
`;

