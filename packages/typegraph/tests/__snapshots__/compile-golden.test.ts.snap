exports[`compile-golden: metadata, dates, fragments, recursive outputs, aliases > fragments with declared aliases > piped filter, traversal and limit fragments > includeTombstones+recorded / sqlite 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    7,
    7,
    "A%",
    "compile_golden",
    "Organization",
    7,
    7,
    7,
    7,
    "worksAt",
    "Organization",
    "Person",
    5,
  ],
  "sql": "WITH 
    cte_p AS (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_recorded_nodes"
      WHERE graph_id = ? AND kind = ? AND (1=1) AND recorded_from <= ? AND ? < recorded_to AND LOWER(json_extract(props, '$."name"')) LIKE LOWER(?) ESCAPE '\\'
    )
  , 
      cte_o AS (
        
      SELECT cte_p.*, e.id AS e_id, e.kind AS e_kind, e.from_id AS e_from_id, e.to_id AS e_to_id, e.props AS e_props, e.valid_from AS e_valid_from, e.valid_to AS e_valid_to, e.created_at AS e_created_at, e.updated_at AS e_updated_at, e.deleted_at AS e_deleted_at, n.id AS o_id, n.kind AS o_kind, n.props AS o_props, n.version AS o_version, n.valid_from AS o_valid_from, n.valid_to AS o_valid_to, n.created_at AS o_created_at, n.updated_at AS o_updated_at, n.deleted_at AS o_deleted_at
      FROM cte_p
      
      JOIN "typegraph_recorded_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = ? AND n.kind = ? AND (1=1) AND e.recorded_from <= ? AND ? < e.recorded_to AND (1=1) AND n.recorded_from <= ? AND ? < n.recorded_to AND e.kind = ? AND e.to_kind = ? AND e.from_kind = ?
    
      )
     SELECT cte_o.p_id AS "p_id", cte_o.p_kind AS "p_kind", cte_o.p_props AS "p_props", cte_o.p_version AS "p_version", cte_o.p_valid_from AS "p_valid_from", cte_o.p_valid_to AS "p_valid_to", cte_o.p_created_at AS "p_created_at", cte_o.p_updated_at AS "p_updated_at", cte_o.p_deleted_at AS "p_deleted_at", cte_o.e_id AS "e_id", cte_o.e_kind AS "e_kind", cte_o.e_from_id AS "e_from_id", cte_o.e_to_id AS "e_to_id", cte_o.e_props AS "e_props", cte_o.e_valid_from AS "e_valid_from", cte_o.e_valid_to AS "e_valid_to", cte_o.e_created_at AS "e_created_at", cte_o.e_updated_at AS "e_updated_at", cte_o.e_deleted_at AS "e_deleted_at", cte_o.o_id AS "o_id", cte_o.o_kind AS "o_kind", cte_o.o_props AS "o_props", cte_o.o_version AS "o_version", cte_o.o_valid_from AS "o_valid_from", cte_o.o_valid_to AS "o_valid_to", cte_o.o_created_at AS "o_created_at", cte_o.o_updated_at AS "o_updated_at", cte_o.o_deleted_at AS "o_deleted_at" FROM cte_o LIMIT ?",
}
`;

