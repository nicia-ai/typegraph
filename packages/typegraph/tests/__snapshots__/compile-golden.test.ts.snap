      "Person",
      1,
      "compile_golden_rank",
      "<generated-id-1>",
    ],
    "sql": "
      WITH seed_values(node_id, node_kind, weight) AS (VALUES (?, ?, CAST(? AS DOUBLE PRECISION)))
      UPDATE "typegraph_iterative_<id>" AS target
      SET score = seed_values.weight,
          personalization = seed_values.weight
      FROM seed_values
      WHERE target.graph_id = ?
        AND target.run_id = ?
        AND target.node_id = seed_values.node_id
        AND target.node_kind = seed_values.node_kind
