      WHERE e.graph_id = $5 AND n.kind = $6 AND (1=1) AND e.recorded_from <= $7 AND $8 < e.recorded_to AND (1=1) AND n.recorded_from <= $9 AND $10 < n.recorded_to AND e.kind = $11 AND e.to_kind = $12 AND e.from_kind = $13
    
