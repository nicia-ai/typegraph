exports[`compile-golden: query compiler ASTs > aggregate with GROUP BY > asOf / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "compile_golden",
    "Organization",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "worksAt",
    "Organization",
    "Person",
  ],
  "sql": "WITH 
    cte_p AS NOT MATERIALIZED (
      SELECT id AS p_id, kind AS p_kind
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4)
    )
  , 
      cte_o AS NOT MATERIALIZED (
        
      SELECT cte_p.p_id AS p_id, cte_p.p_kind AS p_kind, n.id AS o_id, n.kind AS o_kind, n.props AS o_props
      FROM cte_p
      
      JOIN "typegraph_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = $5 AND n.kind = $6 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $7) AND (e.valid_to IS NULL OR e.valid_to > $8) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $9) AND (n.valid_to IS NULL OR n.valid_to > $10) AND e.kind = $11 AND e.to_kind = $12 AND e.from_kind = $13
    
      )
     SELECT cte_o.o_props #>> ARRAY['name'] AS "orgName", COUNT(cte_p.p_id) AS "employeeCount" FROM cte_p INNER JOIN cte_o ON cte_o.p_id = cte_p.p_id AND cte_o.p_kind = cte_p.p_kind GROUP BY cte_o.o_props #>> ARRAY['name']",
}
`;

exports[`compile-golden: query compiler ASTs > aggregate with GROUP BY > asOf / sqlite 1`] = `
