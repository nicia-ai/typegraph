exports[`compile-golden: metadata, dates, fragments, recursive outputs, aliases > set operations: unionAll, except and a chained three-way > except / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "x",
    "compile_golden",
    "Person",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "y",
  ],
  "sql": "(WITH 
    cte_a AS NOT MATERIALIZED (
      SELECT id AS a_id, kind AS a_kind, props AS a_props, version AS a_version, valid_from AS a_valid_from, valid_to AS a_valid_to, created_at AS a_created_at, updated_at AS a_updated_at, deleted_at AS a_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4) AND props #>> ARRAY['name'] = $5
    )
   SELECT cte_a.a_id AS "a_id", cte_a.a_kind AS "a_kind", cte_a.a_props AS "a_props", cte_a.a_version AS "a_version", cte_a.a_valid_from AS "a_valid_from", cte_a.a_valid_to AS "a_valid_to", cte_a.a_created_at AS "a_created_at", cte_a.a_updated_at AS "a_updated_at", cte_a.a_deleted_at AS "a_deleted_at" FROM cte_a) EXCEPT (WITH 
    cte_b AS NOT MATERIALIZED (
      SELECT id AS b_id, kind AS b_kind, props AS b_props, version AS b_version, valid_from AS b_valid_from, valid_to AS b_valid_to, created_at AS b_created_at, updated_at AS b_updated_at, deleted_at AS b_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $6 AND kind = $7 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $8) AND (valid_to IS NULL OR valid_to > $9) AND props #>> ARRAY['name'] = $10
    )
   SELECT cte_b.b_id AS "b_id", cte_b.b_kind AS "b_kind", cte_b.b_props AS "b_props", cte_b.b_version AS "b_version", cte_b.b_valid_from AS "b_valid_from", cte_b.b_valid_to AS "b_valid_to", cte_b.b_created_at AS "b_created_at", cte_b.b_updated_at AS "b_updated_at", cte_b.b_deleted_at AS "b_deleted_at" FROM cte_b)",
}
`;

