        AND run_id = ?
        AND personalization > 0
    ",
  },
  {
    "params": [
      "compile_golden_rank",
      "compile_golden_rank",
      "<generated-id-1>",
      "rates",
      7,
      7,
      "compile_golden_rank",
      "<generated-id-1>",
      "compile_golden_rank",
      "<generated-id-1>",
    ],
    "sql": "
    WITH scoped_edges AS (
      SELECT
        expanded.source_id,
        expanded.source_kind,
        1.0 AS transition_weight
      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, e.to_id AS target_id, e.to_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = ? WHERE w.graph_id = ? AND w.run_id = ? AND e.kind = ? AND (e.deleted_at IS NULL) AND e.recorded_from <= ? AND ? < e.recorded_to) expanded
      JOIN "typegraph_iterative_<id>" scoped_target
        ON scoped_target.graph_id = ?
        AND scoped_target.run_id = ?
        AND scoped_target.node_id = expanded.target_id
        AND scoped_target.node_kind = expanded.target_kind
    ), degrees AS (
      SELECT source_id, source_kind, SUM(transition_weight) AS out_weight
      FROM scoped_edges
      GROUP BY source_id, source_kind
    )
    UPDATE "typegraph_iterative_<id>" AS target
    SET out_weight = target.out_weight + degrees.out_weight
    FROM degrees
    WHERE target.graph_id = ?
      AND target.run_id = ?
      AND target.node_id = degrees.source_id
      AND target.node_kind = degrees.source_kind
  ",
  },
  {
    "params": [
