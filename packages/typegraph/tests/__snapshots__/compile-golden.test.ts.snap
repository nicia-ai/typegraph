exports[`compile-golden: query compiler ASTs > variable-length traversal > asOf / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    4,
    "knows",
    "Person",
    "Person",
    1,
  ],
  "sql": "WITH RECURSIVE 
      recursive_cte AS (
        -- Base case: starting nodes
        SELECT n0.id AS p_id, n0.kind AS p_kind, n0.props AS p_props, n0.version AS p_version, n0.valid_from AS p_valid_from, n0.valid_to AS p_valid_to, n0.created_at AS p_created_at, n0.updated_at AS p_updated_at, n0.deleted_at AS p_deleted_at, n0.id AS friend_id, n0.kind AS friend_kind, n0.props AS friend_props, n0.version AS friend_version, n0.valid_from AS friend_valid_from, n0.valid_to AS friend_valid_to, n0.created_at AS friend_created_at, n0.updated_at AS friend_updated_at, n0.deleted_at AS friend_deleted_at, 0 AS depth, ARRAY[n0.id] AS path
        FROM "typegraph_nodes" n0
        WHERE n0.graph_id = $1 AND n0.kind = $2 AND n0.deleted_at IS NULL AND (n0.valid_from IS NULL OR n0.valid_from <= $3) AND (n0.valid_to IS NULL OR n0.valid_to > $4)

        UNION ALL

        -- Recursive case: follow edges
        
      SELECT r.p_id AS p_id, r.p_kind AS p_kind, r.p_props AS p_props, r.p_version AS p_version, r.p_valid_from AS p_valid_from, r.p_valid_to AS p_valid_to, r.p_created_at AS p_created_at, r.p_updated_at AS p_updated_at, r.p_deleted_at AS p_deleted_at, n.id AS friend_id, n.kind AS friend_kind, n.props AS friend_props, n.version AS friend_version, n.valid_from AS friend_valid_from, n.valid_to AS friend_valid_to, n.created_at AS friend_created_at, n.updated_at AS friend_updated_at, n.deleted_at AS friend_deleted_at, r.depth + 1 AS depth, r.path || n.id AS path
      FROM recursive_cte r
      
      JOIN "typegraph_edges" e ON e.from_id = r.friend_id
      JOIN "typegraph_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = $5 AND n.kind = $6 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $7) AND (e.valid_to IS NULL OR e.valid_to > $8) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $9) AND (n.valid_to IS NULL OR n.valid_to > $10) AND r.depth < $11 AND n.id != ALL(r.path) AND e.kind = $12 AND e.to_kind = $13 AND e.from_kind = $14
    
      )
     SELECT p_id AS "p_id", p_kind AS "p_kind", p_props AS "p_props", p_version AS "p_version", p_valid_from AS "p_valid_from", p_valid_to AS "p_valid_to", p_created_at AS "p_created_at", p_updated_at AS "p_updated_at", p_deleted_at AS "p_deleted_at", friend_id AS "friend_id", friend_kind AS "friend_kind", friend_props AS "friend_props", friend_version AS "friend_version", friend_valid_from AS "friend_valid_from", friend_valid_to AS "friend_valid_to", friend_created_at AS "friend_created_at", friend_updated_at AS "friend_updated_at", friend_deleted_at AS "friend_deleted_at", NULL AS "e_id", NULL AS "e_kind", NULL AS "e_from_id", NULL AS "e_to_id", NULL AS "e_props", NULL AS "e_valid_from", NULL AS "e_valid_to", NULL AS "e_created_at", NULL AS "e_updated_at", NULL AS "e_deleted_at" FROM recursive_cte AS "__tg_recursive_result_0" WHERE depth >= $15",
