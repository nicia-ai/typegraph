exports[`compile-golden: query compiler ASTs > approximate vector similarity > cosine, approximate / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Document",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "Document",
    "[0.1,0.2,0.3]",
    "[0.1,0.2,0.3]",
    "compile_golden",
    "Document",
    "[0.1,0.2,0.3]",
    5,
    5,
    5,
  ],
  "sql": "WITH 
    cte_d AS NOT MATERIALIZED (
      SELECT id AS d_id, kind AS d_kind, props AS d_props, version AS d_version, valid_from AS d_valid_from, valid_to AS d_valid_to, created_at AS d_created_at, updated_at AS d_updated_at, deleted_at AS d_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4) AND 1=1
    )
  , 
    cte_embeddings AS (
      SELECT
        node_id,
        node_kind,
        distance,
        score,
        ROW_NUMBER() OVER (ORDER BY distance ASC NULLS LAST, node_kind COLLATE "C" ASC, node_id COLLATE "C" ASC) AS ord
      FROM (
        SELECT
          node_id,
          node_kind,
          distance,
          score
        FROM (
          
        SELECT node_id, $5 AS node_kind, (1.0 - score) AS distance, score
        FROM (
        WITH tg_vec_index_candidates AS MATERIALIZED (
        SELECT "tg_vec_compile_golden_document_embedding_8872495b"."node_id" AS node_id, (1 - (("tg_vec_compile_golden_document_embedding_8872495b"."embedding" <=> $6::vector))) AS score, ("tg_vec_compile_golden_document_embedding_8872495b"."embedding" <=> $7::vector) AS distance
        FROM "tg_vec_compile_golden_document_embedding_8872495b"
        WHERE "tg_vec_compile_golden_document_embedding_8872495b"."graph_id" = $8 AND "tg_vec_compile_golden_document_embedding_8872495b"."node_id" IN (SELECT cte_d.d_id FROM cte_d WHERE cte_d.d_kind = $9)
        ORDER BY ("tg_vec_compile_golden_document_embedding_8872495b"."embedding" <=> $10::vector) ASC
        FETCH FIRST $11 ROWS WITH TIES
      )
        SELECT node_id, score FROM tg_vec_index_candidates
        WHERE distance < 3
        ORDER BY (distance + 0) ASC NULLS LAST, node_id COLLATE "C" ASC
        LIMIT $12
      ) AS tg_ann_src
      
        ) AS vec_candidates
        ORDER BY distance ASC NULLS LAST, node_kind COLLATE "C" ASC, node_id COLLATE "C" ASC
        LIMIT $13
      ) AS vec_inner
    )
   SELECT cte_d.d_id AS "d_id", cte_d.d_kind AS "d_kind", cte_d.d_props AS "d_props", cte_d.d_version AS "d_version", cte_d.d_valid_from AS "d_valid_from", cte_d.d_valid_to AS "d_valid_to", cte_d.d_created_at AS "d_created_at", cte_d.d_updated_at AS "d_updated_at", cte_d.d_deleted_at AS "d_deleted_at" FROM cte_d INNER JOIN cte_embeddings ON cte_embeddings.node_id = cte_d.d_id AND cte_embeddings.node_kind = cte_d.d_kind ORDER BY CAST(cte_embeddings.distance AS DOUBLE PRECISION) ASC NULLS LAST, cte_d.d_id ASC NULLS LAST",
}
`;

exports[`compile-golden: query compiler ASTs > approximate vector similarity > cosine, approximate / sqlite (libsql strategy) 1`] = `
{
  "params": [
    "compile_golden",
    "Document",
    "2026-01-01T00:00:00.000Z",
    "2026-01-01T00:00:00.000Z",
    "Document",
    "[0.1,0.2,0.3]",
    "tg_vecidx_compile_golden_document_embedding_8872495b",
    "[0.1,0.2,0.3]",
    20,
    "compile_golden",
    "[0.1,0.2,0.3]",
    "Document",
    "[0.1,0.2,0.3]",
    5,
    5,
  ],
  "sql": "WITH 
    cte_d AS (
      SELECT id AS d_id, kind AS d_kind, props AS d_props, version AS d_version, valid_from AS d_valid_from, valid_to AS d_valid_to, created_at AS d_created_at, updated_at AS d_updated_at, deleted_at AS d_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = ? AND kind = ? AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= ?) AND (valid_to IS NULL OR valid_to > ?) AND 1=1
    )
  , 
    cte_embeddings AS (
      SELECT
        node_id,
        node_kind,
        distance,
        score,
        ROW_NUMBER() OVER (ORDER BY distance ASC NULLS LAST, node_kind ASC, node_id ASC) AS ord
      FROM (
        SELECT
          node_id,
          node_kind,
          distance,
          score
        FROM (
          
        SELECT node_id, ? AS node_kind, (1.0 - score) AS distance, score
        FROM (
        SELECT "tg_vec_compile_golden_document_embedding_8872495b"."node_id" AS node_id, (1 - (vector_distance_cos("tg_vec_compile_golden_document_embedding_8872495b"."embedding", vector32(?)))) AS score
        FROM vector_top_k(?, vector32(?), ?)
        JOIN "tg_vec_compile_golden_document_embedding_8872495b" ON "tg_vec_compile_golden_document_embedding_8872495b".rowid = id
        WHERE "tg_vec_compile_golden_document_embedding_8872495b"."graph_id" = ? AND vector_distance_cos("tg_vec_compile_golden_document_embedding_8872495b"."embedding", vector32(?)) < 3 AND "tg_vec_compile_golden_document_embedding_8872495b"."node_id" IN (SELECT cte_d.d_id FROM cte_d WHERE cte_d.d_kind = ?)
        ORDER BY vector_distance_cos("tg_vec_compile_golden_document_embedding_8872495b"."embedding", vector32(?)) ASC NULLS LAST, "tg_vec_compile_golden_document_embedding_8872495b"."node_id" ASC
        LIMIT ?
      ) AS tg_ann_src
      
        ) AS vec_candidates
        ORDER BY distance ASC NULLS LAST, node_kind ASC, node_id ASC
        LIMIT ?
      ) AS vec_inner
    )
   SELECT cte_d.d_id AS "d_id", cte_d.d_kind AS "d_kind", cte_d.d_props AS "d_props", cte_d.d_version AS "d_version", cte_d.d_valid_from AS "d_valid_from", cte_d.d_valid_to AS "d_valid_to", cte_d.d_created_at AS "d_created_at", cte_d.d_updated_at AS "d_updated_at", cte_d.d_deleted_at AS "d_deleted_at" FROM cte_d INNER JOIN cte_embeddings ON cte_embeddings.node_id = cte_d.d_id AND cte_embeddings.node_kind = cte_d.d_kind ORDER BY cte_embeddings.distance ASC NULLS LAST, cte_d.d_id ASC NULLS LAST",
}
`;

