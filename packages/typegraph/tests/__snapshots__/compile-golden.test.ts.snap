    "2025-03-01T00:00:00.000Z",
    7,
    7,
    "worksAt",
    "Organization",
    "Person",
    1,
  ],
  "sql": "SELECT "typegraph_relation_source"."org" AS "org", "typegraph_relation_source"."person" AS "person", "typegraph_relation_source"."name" AS "name" FROM (SELECT "typegraph_relation_source"."org", "typegraph_relation_source"."person", "typegraph_relation_source"."name" FROM (SELECT "typegraph_relation_source".*, ROW_NUMBER() OVER (PARTITION BY "typegraph_relation_source"."org" ORDER BY "typegraph_relation_source"."name" ASC NULLS LAST) AS "__tg_partition_rank" FROM (SELECT "typegraph_relation_source"."org" AS "org", "typegraph_relation_source"."person" AS "person", "typegraph_relation_source"."name" AS "name" FROM (WITH 
    cte_p AS NOT MATERIALIZED (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_recorded_nodes"
      WHERE graph_id = $1 AND kind = $2 AND (deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4)) AND recorded_from <= $5 AND $6 < recorded_to
    )
  , 
      cte_o AS NOT MATERIALIZED (
        
      SELECT cte_p.*, e.id AS e_id, e.kind AS e_kind, e.from_id AS e_from_id, e.to_id AS e_to_id, e.props AS e_props, e.valid_from AS e_valid_from, e.valid_to AS e_valid_to, e.created_at AS e_created_at, e.updated_at AS e_updated_at, e.deleted_at AS e_deleted_at, n.id AS o_id, n.kind AS o_kind, n.props AS o_props, n.version AS o_version, n.valid_from AS o_valid_from, n.valid_to AS o_valid_to, n.created_at AS o_created_at, n.updated_at AS o_updated_at, n.deleted_at AS o_deleted_at
      FROM cte_p
      
      JOIN "typegraph_recorded_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = $7 AND n.kind = $8 AND (e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $9) AND (e.valid_to IS NULL OR e.valid_to > $10)) AND e.recorded_from <= $11 AND $12 < e.recorded_to AND (n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $13) AND (n.valid_to IS NULL OR n.valid_to > $14)) AND n.recorded_from <= $15 AND $16 < n.recorded_to AND e.kind = $17 AND e.to_kind = $18 AND e.from_kind = $19
    
      )
     SELECT cte_o.o_id AS "org", cte_o.p_id AS "person", cte_o.p_props #>> ARRAY['name'] AS "name" FROM cte_o) AS "typegraph_relation_source" ) AS "typegraph_relation_source") AS "typegraph_relation_source" WHERE "typegraph_relation_source"."__tg_partition_rank" <= $20) AS "typegraph_relation_source" ",
}
`;

