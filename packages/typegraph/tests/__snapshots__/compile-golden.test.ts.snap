      WHERE e.graph_id = $8 AND n.kind = $9 AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $10) AND (e.valid_to IS NULL OR e.valid_to > $11) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $12) AND (n.valid_to IS NULL OR n.valid_to > $13) AND (identity_peer.member_id IS NULL OR identity_peer_node.id IS NOT NULL) AND e.kind = $14 AND e.to_kind = $15
    
