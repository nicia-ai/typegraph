    cte_o AS NOT MATERIALIZED (
      SELECT id AS o_id, kind AS o_kind, props AS o_props, version AS o_version, valid_from AS o_valid_from, valid_to AS o_valid_to, created_at AS o_created_at, updated_at AS o_updated_at, deleted_at AS o_deleted_at
