    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    "typegraph refactor",
    "compile_golden",
    "Document",
    "typegraph refactor",
    10,
  ],
  "sql": "WITH 
    cte_d AS NOT MATERIALIZED (
      SELECT id AS d_id, kind AS d_kind, props AS d_props, version AS d_version, valid_from AS d_valid_from, valid_to AS d_valid_to, created_at AS d_created_at, updated_at AS d_updated_at, deleted_at AS d_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4) AND 1=1
    )
  , 
    cte_fulltext AS (
      SELECT
        node_id,
        node_kind,
        rank,
        ROW_NUMBER() OVER (ORDER BY rank DESC NULLS LAST, node_kind COLLATE "C" ASC, node_id COLLATE "C" ASC) AS ord
      FROM (
        SELECT
          "typegraph_node_fulltext"."node_id" AS node_id,
          "typegraph_node_fulltext"."node_kind" AS node_kind,
          ts_rank_cd("typegraph_node_fulltext"."tsv", websearch_to_tsquery("language", $5)) AS rank
        FROM "typegraph_node_fulltext"
        INNER JOIN 
    (
        SELECT DISTINCT
          cte_d.d_id AS node_id,
          cte_d.d_kind AS node_kind
        FROM cte_d
      ) AS scoped_relevance_nodes
  
          ON scoped_relevance_nodes.node_id =
             "typegraph_node_fulltext"."node_id"
         AND scoped_relevance_nodes.node_kind =
             "typegraph_node_fulltext"."node_kind"
        WHERE "typegraph_node_fulltext"."graph_id" = $6 AND "typegraph_node_fulltext"."node_kind" = $7 AND "typegraph_node_fulltext"."tsv" @@ websearch_to_tsquery("language", $8)
        ORDER BY rank DESC NULLS LAST, "typegraph_node_fulltext"."node_kind" COLLATE "C" ASC, "typegraph_node_fulltext"."node_id" COLLATE "C" ASC
        LIMIT $9
      ) AS fts_inner
    )
   SELECT cte_d.d_id AS "d_id", cte_d.d_kind AS "d_kind", cte_d.d_props AS "d_props", cte_d.d_version AS "d_version", cte_d.d_valid_from AS "d_valid_from", cte_d.d_valid_to AS "d_valid_to", cte_d.d_created_at AS "d_created_at", cte_d.d_updated_at AS "d_updated_at", cte_d.d_deleted_at AS "d_deleted_at" FROM cte_d INNER JOIN cte_fulltext ON cte_fulltext.node_id = cte_d.d_id AND cte_fulltext.node_kind = cte_d.d_kind ORDER BY CAST(cte_fulltext.rank AS DOUBLE PRECISION) DESC NULLS LAST, cte_d.d_id ASC NULLS LAST",
}
`;

