          FROM (SELECT expanded.source_id, expanded.source_kind, n.id AS target_id, n.kind AS target_kind FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, e.to_id AS target_id, e.to_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = ? WHERE 
      w.graph_id = ?
      AND w.run_id = ?
      AND w.side = ?
      AND w.depth = ?
     AND e.kind = ? AND (1=1) AND e.recorded_from <= ? AND ? < e.recorded_to) expanded JOIN "typegraph_recorded_nodes" n ON n.graph_id = ? AND n.id = expanded.target_id AND n.kind = expanded.target_kind WHERE (1=1) AND n.recorded_from <= ? AND ? < n.recorded_to) expanded
        ) ranked
        WHERE ranked.candidate_rank = 1
          AND NOT EXISTS (
            SELECT 1
            FROM "typegraph_iterative_<id>" visited
            WHERE visited.graph_id = ?
              AND visited.run_id = ?
              AND visited.side = ?
              AND visited.node_id = ranked.target_id
              AND visited.node_kind = ranked.target_kind
          )
        ON CONFLICT (graph_id, run_id, side, node_kind, node_id) DO NOTHING
        RETURNING node_id, node_kind, meeting_depth
