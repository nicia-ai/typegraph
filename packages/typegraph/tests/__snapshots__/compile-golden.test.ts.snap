        SELECT audited.edge_id, audited.edge_kind, audited.weight_text,
          audited.is_number, audited.is_missing
        FROM (
          SELECT e.id AS edge_id, e.kind AS edge_kind,
            e.props #>> ARRAY['weight'] AS weight_text,
            CASE WHEN COALESCE(jsonb_typeof(e.props #> ARRAY['weight']) = 'number', FALSE) THEN (e.props #>> ARRAY['weight'])::numeric END AS weight_number,
            CASE WHEN COALESCE(jsonb_typeof(e.props #> ARRAY['weight']) = 'number', FALSE) THEN 1 ELSE 0 END AS is_number,
            CASE WHEN COALESCE(jsonb_typeof(e.props #> ARRAY['weight']) = 'null', TRUE) THEN 1 ELSE 0 END AS is_missing
          FROM "typegraph_edges" e
          WHERE e.graph_id = $1
            AND e.kind = $2
            AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= $3) AND (e.valid_to IS NULL OR e.valid_to > $4)
        ) audited
        WHERE (FALSE)
          OR (audited.is_missing = 0 AND audited.is_number = 0)
          OR (audited.is_number = 1 AND audited.weight_number < 0)
          OR (audited.is_number = 1 AND (ABS(audited.weight_number) > CAST($5 AS NUMERIC) OR (audited.weight_number <> 0 AND ABS(audited.weight_number) < CAST($6 AS NUMERIC))))
        ORDER BY audited.edge_id COLLATE "C"
        LIMIT 1
      ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "person-2",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
    ],
    "sql": "
      SELECT n.id FROM "typegraph_nodes" n
      WHERE n.graph_id = $1
        AND n.id = $2
        AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $3) AND (n.valid_to IS NULL OR n.valid_to > $4)
      LIMIT 1
    ",
  },
  {
    "params": [],
    "sql": "
        CREATE INDEX "typegraph_iterative_<id>_frontier"
        ON "typegraph_iterative_<id>" (graph_id, run_id, improved_round)
      ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      "compile_golden_algorithm_statements",
      "person-1",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
    ],
    "sql": "
      INSERT INTO "typegraph_iterative_<id>"
        (graph_id, run_id, node_id, node_kind, distance, hops,
         predecessor_id, predecessor_kind, improved_round)
      SELECT $1, $2, n.id, n.kind, 0, 0, NULL, NULL, 0
      FROM "typegraph_nodes" n
      WHERE n.graph_id = $3
        AND n.id = $4
        AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $5) AND (n.valid_to IS NULL OR n.valid_to > $6)
      ON CONFLICT (graph_id, run_id, node_kind, node_id) DO NOTHING
      RETURNING node_id
    ",
  },
  {
    "params": [
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      1,
      1,
      "compile_golden_algorithm_statements",
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
      0,
      "knows",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
      "compile_golden_algorithm_statements",
      "2025-03-01T00:00:00.000Z",
      "2025-03-01T00:00:00.000Z",
      "compile_golden_algorithm_statements",
      "<generated-id-1>",
    ],
    "sql": "
        INSERT INTO "typegraph_iterative_<id>"
          (graph_id, run_id, node_id, node_kind, distance, hops,
           predecessor_id, predecessor_kind, improved_round)
        SELECT
          $1, $2, ranked.target_id, ranked.target_kind,
          ranked.candidate_distance, ranked.candidate_hops,
          ranked.source_id, ranked.source_kind, $3
        FROM (
          SELECT candidates.*,
            ROW_NUMBER() OVER (
              PARTITION BY candidates.target_kind COLLATE "C",
                candidates.target_id COLLATE "C"
              ORDER BY candidates.candidate_distance,
                candidates.source_id COLLATE "C",
                candidates.source_kind COLLATE "C"
            ) AS candidate_rank
          FROM (
            SELECT expanded.source_id, expanded.source_kind,
              expanded.target_id, expanded.target_kind,
              frontier.distance + expanded.weight AS candidate_distance,
              frontier.hops + 1 AS candidate_hops
