    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
  ],
  "sql": "(WITH 
    cte_p AS NOT MATERIALIZED (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4)
    )
   SELECT cte_p.p_id AS "p_id", cte_p.p_kind AS "p_kind", cte_p.p_props AS "p_props", cte_p.p_version AS "p_version", cte_p.p_valid_from AS "p_valid_from", cte_p.p_valid_to AS "p_valid_to", cte_p.p_created_at AS "p_created_at", cte_p.p_updated_at AS "p_updated_at", cte_p.p_deleted_at AS "p_deleted_at" FROM cte_p) UNION (WITH 
    cte_p2 AS NOT MATERIALIZED (
      SELECT id AS p2_id, kind AS p2_kind, props AS p2_props, version AS p2_version, valid_from AS p2_valid_from, valid_to AS p2_valid_to, created_at AS p2_created_at, updated_at AS p2_updated_at, deleted_at AS p2_deleted_at
      FROM "typegraph_nodes"
      WHERE graph_id = $5 AND kind = $6 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $7) AND (valid_to IS NULL OR valid_to > $8)
    )
   SELECT cte_p2.p2_id AS "p2_id", cte_p2.p2_kind AS "p2_kind", cte_p2.p2_props AS "p2_props", cte_p2.p2_version AS "p2_version", cte_p2.p2_valid_from AS "p2_valid_from", cte_p2.p2_valid_to AS "p2_valid_to", cte_p2.p2_created_at AS "p2_created_at", cte_p2.p2_updated_at AS "p2_updated_at", cte_p2.p2_deleted_at AS "p2_deleted_at" FROM cte_p2)",
}
`;

