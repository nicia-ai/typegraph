exports[`compile-golden: metadata, dates, fragments, recursive outputs, aliases > fragments with declared aliases > piped filter, traversal and limit fragments > asOf+recorded / postgres 1`] = `
{
  "params": [
    "compile_golden",
    "Person",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    7,
    7,
    "A%",
    "compile_golden",
    "Organization",
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    7,
    7,
    "2025-03-01T00:00:00.000Z",
    "2025-03-01T00:00:00.000Z",
    7,
    7,
    "worksAt",
    "Organization",
    "Person",
    5,
  ],
  "sql": "WITH 
    cte_p AS NOT MATERIALIZED (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_recorded_nodes"
      WHERE graph_id = $1 AND kind = $2 AND (deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4)) AND recorded_from <= $5 AND $6 < recorded_to AND props #>> ARRAY['name'] ILIKE $7 ESCAPE '\\'
    )
  , 
      cte_o AS NOT MATERIALIZED (
        
      SELECT cte_p.*, e.id AS e_id, e.kind AS e_kind, e.from_id AS e_from_id, e.to_id AS e_to_id, e.props AS e_props, e.valid_from AS e_valid_from, e.valid_to AS e_valid_to, e.created_at AS e_created_at, e.updated_at AS e_updated_at, e.deleted_at AS e_deleted_at, n.id AS o_id, n.kind AS o_kind, n.props AS o_props, n.version AS o_version, n.valid_from AS o_valid_from, n.valid_to AS o_valid_to, n.created_at AS o_created_at, n.updated_at AS o_updated_at, n.deleted_at AS o_deleted_at
      FROM cte_p
      
      JOIN "typegraph_recorded_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
      JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
