    ),
    identity_members(seed_kind, seed_id, kind, id) AS (
      SELECT seeds.seed_kind, seeds.seed_id, seeds.seed_kind, seeds.seed_id
      FROM seeds
      JOIN node_snapshot n
        ON n.kind = seeds.seed_kind AND n.id = seeds.seed_id
      WHERE 1 = 1
        AND 
    "n"."deleted_at" IS NULL
    AND ("n"."valid_from" IS NULL OR "n"."valid_from" <= ?)
    AND ("n"."valid_to" IS NULL OR "n"."valid_to" > ?)
  
      UNION
      SELECT member.seed_kind, member.seed_id, edge.b_kind, edge.b_id
      FROM identity_members member
      JOIN identity_edges edge
        ON edge.a_kind = member.kind
       AND edge.a_id = member.id
    )
  
    SELECT member.seed_kind, member.seed_id, member.kind, member.id
    FROM identity_members member
    JOIN node_snapshot n ON n.kind = member.kind AND n.id = member.id
    WHERE 
    "n"."deleted_at" IS NULL
    AND ("n"."valid_from" IS NULL OR "n"."valid_from" <= ?)
    AND ("n"."valid_to" IS NULL OR "n"."valid_to" > ?)
  
  
    )
  , 
    cte_p AS (
      SELECT id AS p_id, kind AS p_kind, props AS p_props, version AS p_version, valid_from AS p_valid_from, valid_to AS p_valid_to, created_at AS p_created_at, updated_at AS p_updated_at, deleted_at AS p_deleted_at
      FROM "typegraph_recorded_nodes"
      WHERE graph_id = ? AND kind = ? AND (deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= ?) AND (valid_to IS NULL OR valid_to > ?)) AND recorded_from <= ? AND ? < recorded_to
    )
  , 
      cte_friend AS (
        
        SELECT cte_p.*, e.id AS e_id, e.kind AS e_kind, e.from_id AS e_from_id, e.to_id AS e_to_id, e.props AS e_props, e.valid_from AS e_valid_from, e.valid_to AS e_valid_to, e.created_at AS e_created_at, e.updated_at AS e_updated_at, e.deleted_at AS e_deleted_at, n.id AS friend_id, n.kind AS friend_kind, n.props AS friend_props, n.version AS friend_version, n.valid_from AS friend_valid_from, n.valid_to AS friend_valid_to, n.created_at AS friend_created_at, n.updated_at AS friend_updated_at, n.deleted_at AS friend_deleted_at
        FROM cte_p
        
      LEFT JOIN "identity_peer_class" "identity_peer"
        ON "identity_peer".seed_kind = cte_p.p_kind
       AND "identity_peer".seed_id = cte_p.p_id
    
        CROSS JOIN "typegraph_recorded_edges" e
        JOIN "typegraph_recorded_nodes" n ON n.graph_id = e.graph_id
          AND n.id = e.to_id
          AND n.kind = e.to_kind
        WHERE 
        COALESCE("identity_peer".id, cte_p.p_id) = e.from_id
        AND COALESCE("identity_peer".kind, cte_p.p_kind) = e.from_kind
       AND e.graph_id = ? AND n.kind = ? AND (e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= ?) AND (e.valid_to IS NULL OR e.valid_to > ?)) AND e.recorded_from <= ? AND ? < e.recorded_to AND (n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= ?) AND (n.valid_to IS NULL OR n.valid_to > ?)) AND n.recorded_from <= ? AND ? < n.recorded_to AND e.kind = ? AND e.to_kind = ?
      
      )
     SELECT cte_friend.p_id AS "p_id", cte_friend.p_kind AS "p_kind", cte_friend.p_props AS "p_props", cte_friend.p_version AS "p_version", cte_friend.p_valid_from AS "p_valid_from", cte_friend.p_valid_to AS "p_valid_to", cte_friend.p_created_at AS "p_created_at", cte_friend.p_updated_at AS "p_updated_at", cte_friend.p_deleted_at AS "p_deleted_at", cte_friend.e_id AS "e_id", cte_friend.e_kind AS "e_kind", cte_friend.e_from_id AS "e_from_id", cte_friend.e_to_id AS "e_to_id", cte_friend.e_props AS "e_props", cte_friend.e_valid_from AS "e_valid_from", cte_friend.e_valid_to AS "e_valid_to", cte_friend.e_created_at AS "e_created_at", cte_friend.e_updated_at AS "e_updated_at", cte_friend.e_deleted_at AS "e_deleted_at", cte_friend.friend_id AS "friend_id", cte_friend.friend_kind AS "friend_kind", cte_friend.friend_props AS "friend_props", cte_friend.friend_version AS "friend_version", cte_friend.friend_valid_from AS "friend_valid_from", cte_friend.friend_valid_to AS "friend_valid_to", cte_friend.friend_created_at AS "friend_created_at", cte_friend.friend_updated_at AS "friend_updated_at", cte_friend.friend_deleted_at AS "friend_deleted_at" FROM cte_friend",
}
`;

