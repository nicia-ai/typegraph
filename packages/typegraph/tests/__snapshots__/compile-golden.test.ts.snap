      SELECT ?, ?, n.id, n.kind, 0.0, 0.0, 0.0, 0.0
      FROM "typegraph_recorded_nodes" n
      WHERE n.graph_id = ?
        AND TRUE
        AND (n.deleted_at IS NULL) AND n.recorded_from <= ? AND ? < n.recorded_to
    ",
  },
  {
