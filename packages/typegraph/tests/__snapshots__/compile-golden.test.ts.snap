        (graph_id, run_id, node_id, node_kind, "label_id", "label_kind", "next_label_id", "next_label_kind", "improved_round")
      SELECT $1, $2, n.id, n.kind, n.id, n.kind, n.id, n.kind, 0
      FROM "typegraph_nodes" n
      WHERE n.graph_id = $3
        AND TRUE
        AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= $4) AND (n.valid_to IS NULL OR n.valid_to > $5)
