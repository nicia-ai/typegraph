      JOIN "typegraph_nodes" n ON n.graph_id = e.graph_id
        AND n.id = e.to_id
        AND n.kind = e.to_kind
      WHERE e.graph_id = ? AND n.kind = ? AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= ?) AND (e.valid_to IS NULL OR e.valid_to > ?) AND n.deleted_at IS NULL AND (n.valid_from IS NULL OR n.valid_from <= ?) AND (n.valid_to IS NULL OR n.valid_to > ?) AND json_extract(n.props, '$."industry"') = ? AND e.kind = ? AND e.to_kind = ? AND e.from_kind = ?
    
      )
     SELECT cte_employer.candidate_id AS "candidate_id" FROM cte_employer) AS "update_selected_candidates") AS "update_branch_0"
      ",
}
`;

