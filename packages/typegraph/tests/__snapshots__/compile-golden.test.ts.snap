      FROM "typegraph_nodes"
      WHERE graph_id = ? AND kind = ? AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= ?) AND (valid_to IS NULL OR valid_to > ?)
    )
  , 
      cte_o AS (
        
      SELECT cte_p.p_id AS p_id, cte_p.p_kind AS p_kind, n.id AS o_id, n.kind AS o_kind, n.props AS o_props
      FROM cte_p
      
      JOIN "typegraph_edges" e ON 
      cte_p.p_id = e.from_id
      AND cte_p.p_kind = e.from_kind
    
