      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, w."score" AS source_score, w.out_weight AS source_out_weight, e.to_id AS target_id, e.to_kind AS target_kind, (e.props #>> ARRAY['weight'])::double precision AS weight FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = $1 WHERE w.graph_id = $2 AND w.run_id = $3 AND e.kind = $4 AND (1=1) AND e.recorded_from <= $5 AND $6 < e.recorded_to) expanded
