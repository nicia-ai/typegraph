      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, w."score" AS source_score, w.out_weight AS source_out_weight, e.to_id AS target_id, e.to_kind AS target_kind, COALESCE(CAST(json_extract(e.props, '$."weight"') AS REAL), CAST(? AS DOUBLE PRECISION)) AS weight FROM "typegraph_iterative_<id>" w JOIN "typegraph_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = ? WHERE w.graph_id = ? AND w.run_id = ? AND e.kind = ? AND e.deleted_at IS NULL AND (e.valid_from IS NULL OR e.valid_from <= ?) AND (e.valid_to IS NULL OR e.valid_to > ?)) expanded
      JOIN "typegraph_iterative_<id>" scoped_target
        ON scoped_target.graph_id = ?
        AND scoped_target.run_id = ?
        AND scoped_target.node_id = expanded.target_id
        AND scoped_target.node_kind = expanded.target_kind
      WHERE expanded.source_out_weight > 0.0
    ), contributions AS (
      SELECT
        target_id,
        target_kind,
        SUM(source_score * (transition_weight / source_out_weight)) AS score
      FROM scoped_edges
      GROUP BY target_id, target_kind
    )
    UPDATE "typegraph_iterative_<id>" AS target
    SET "next_score" = target."next_score" + ? * contributions.score
    FROM contributions
    WHERE target.graph_id = ?
      AND target.run_id = ?
      AND target.node_id = contributions.target_id
      AND target.node_kind = contributions.target_kind
  ",
