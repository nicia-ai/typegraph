exports[`compile-golden: store statement builders > separation-probe statements (separationRebuildRequired) > current, owed separation exists / postgres 1`] = `
[
  {
    "params": [
      "compile_golden",
      "different",
      "2026-01-01T00:00:00.000Z",
      "2026-01-01T00:00:00.000Z",
    ],
    "sql": "
      SELECT 1 AS present
      FROM (
    SELECT graph_id, id, rel, a_kind, a_id, b_kind, b_id, valid_from, valid_to, created_at, updated_at, deleted_at, ended_by_kind, ended_by_id
    FROM "typegraph_identity_assertions"
    WHERE graph_id = $1
      
      AND deleted_at IS NULL
      AND rel = $2
      AND valid_from <= $3
      AND (valid_to IS NULL OR valid_to > $4)
  ) live_different
      LIMIT 1
    ",
  },
  {
    "params": [
      "compile_golden",
      "different",
      "2026-01-01T00:00:00.000Z",
      "2026-01-01T00:00:00.000Z",
      "compile_golden",
      "compile_golden",
      "Person",
      "Organization",
      "Document",
      "Person",
      "Organization",
      "Document",
    ],
    "sql": "
      SELECT 1 AS present
      FROM (
    SELECT graph_id, id, rel, a_kind, a_id, b_kind, b_id, valid_from, valid_to, created_at, updated_at, deleted_at, ended_by_kind, ended_by_id
    FROM "typegraph_identity_assertions"
    WHERE graph_id = $1
      
      AND deleted_at IS NULL
      AND rel = $2
      AND valid_from <= $3
      AND (valid_to IS NULL OR valid_to > $4)
  ) live_different
      LEFT JOIN "typegraph_identity_closure" class_a
        ON class_a.graph_id = $5
       AND class_a.member_kind = live_different.a_kind
       AND class_a.member_id = live_different.a_id
      LEFT JOIN "typegraph_identity_closure" class_b
        ON class_b.graph_id = $6
       AND class_b.member_kind = live_different.b_kind
       AND class_b.member_id = live_different.b_id
      WHERE live_different.a_kind IN ($7, $8, $9)
        AND live_different.b_kind IN ($10, $11, $12)
        AND (
          COALESCE(class_a.class_kind, live_different.a_kind)
            <> COALESCE(class_b.class_kind, live_different.b_kind)
          OR COALESCE(class_a.class_id, live_different.a_id)
            <> COALESCE(class_b.class_id, live_different.b_id)
        )
        LIMIT 1
    ",
  },
]
`;

