      "compile_golden_analytics",
    ],
    "sql": "
      SELECT origin
      FROM "typegraph_revision_origins"
      WHERE graph_id = ?
    ",
  },
  {
    "params": [],
    "sql": "
    CREATE TEMP TABLE "typegraph_iterative_<id>" (
      graph_id TEXT NOT NULL,
      run_id TEXT NOT NULL,
      node_id TEXT NOT NULL,
      node_kind TEXT NOT NULL,
      label_id TEXT NOT NULL,
      label_kind TEXT NOT NULL,
      next_label_id TEXT NOT NULL,
      next_label_kind TEXT NOT NULL,
      improved_round INTEGER NOT NULL,
      PRIMARY KEY (graph_id, run_id, node_kind, node_id)
    )
  ",
  },
  {
    "params": [
      "compile_golden_analytics",
      "<generated-id-1>",
      "compile_golden_analytics",
      7,
      7,
    ],
    "sql": "
      INSERT INTO "typegraph_iterative_<id>"
        (graph_id, run_id, node_id, node_kind, "label_id", "label_kind", "next_label_id", "next_label_kind", "improved_round")
      SELECT ?, ?, n.id, n.kind, n.id, n.kind, n.id, n.kind, 0
      FROM "typegraph_recorded_nodes" n
      WHERE n.graph_id = ?
        AND TRUE
        AND (1=1) AND n.recorded_from <= ? AND ? < n.recorded_to
    ",
  },
  {
    "params": [],
    "sql": "
    CREATE INDEX "typegraph_iterative_<id>_frontier"
    ON "typegraph_iterative_<id>" (graph_id, run_id, improved_round)
  ",
  },
  {
    "params": [
      "compile_golden_analytics",
      "<generated-id-1>",
    ],
    "sql": "
      SELECT COUNT(*) AS count
      FROM "typegraph_iterative_<id>"
      WHERE graph_id = ? AND run_id = ?
    ",
  },
  {
    "params": [
      "compile_golden_analytics",
      "compile_golden_analytics",
      "<generated-id-1>",
      0,
      "knows",
      7,
      7,
      "compile_golden_analytics",
      "compile_golden_analytics",
      "<generated-id-1>",
      0,
      "knows",
      7,
      7,
      "compile_golden_analytics",
      "<generated-id-1>",
      "compile_golden_analytics",
      "<generated-id-1>",
    ],
    "sql": "
    WITH candidates AS (
      SELECT
        expanded.target_id,
        expanded.target_kind,
        expanded.source_label_id AS label_id,
        expanded.source_label_kind AS label_kind
      FROM (SELECT w.node_id AS source_id, w.node_kind AS source_kind, w.label_id AS source_label_id, w.label_kind AS source_label_kind, e.to_id AS target_id, e.to_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.from_id = w.node_id AND e.from_kind = w.node_kind AND e.graph_id = ? WHERE 
      w.graph_id = ?
      AND w.run_id = ?
      AND w.improved_round = ?
     AND e.kind = ? AND (1=1) AND e.recorded_from <= ? AND ? < e.recorded_to UNION ALL SELECT w.node_id AS source_id, w.node_kind AS source_kind, w.label_id AS source_label_id, w.label_kind AS source_label_kind, e.from_id AS target_id, e.from_kind AS target_kind FROM "typegraph_iterative_<id>" w JOIN "typegraph_recorded_edges" e ON e.to_id = w.node_id AND e.to_kind = w.node_kind AND e.graph_id = ? WHERE 
      w.graph_id = ?
      AND w.run_id = ?
      AND w.improved_round = ?
     AND e.kind = ? AND (1=1) AND e.recorded_from <= ? AND ? < e.recorded_to) expanded
      JOIN "typegraph_iterative_<id>" scoped_target
        ON scoped_target.graph_id = ?
        AND scoped_target.run_id = ?
        AND scoped_target.node_id = expanded.target_id
        AND scoped_target.node_kind = expanded.target_kind
    ), ranked AS (
      SELECT
        target_id,
        target_kind,
        label_id,
        label_kind,
        ROW_NUMBER() OVER (
          PARTITION BY source.target_kind, source.target_id
          ORDER BY source.label_id, source.label_kind
        ) AS candidate_rank
      FROM candidates source
    )
    UPDATE "typegraph_iterative_<id>" AS target
    SET next_label_id = ranked.label_id,
        next_label_kind = ranked.label_kind
    FROM ranked
    WHERE target.graph_id = ?
      AND target.run_id = ?
      AND target.node_id = ranked.target_id
      AND target.node_kind = ranked.target_kind
      AND ranked.candidate_rank = 1
      AND (
        ranked.label_id < target.next_label_id
        OR (
          ranked.label_id = target.next_label_id
          AND ranked.label_kind < target.next_label_kind
        )
      )
  ",
