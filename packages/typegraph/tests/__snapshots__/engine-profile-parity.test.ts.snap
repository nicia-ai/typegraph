      "Document",
      "<<TIMESTAMP>>",
      "<<TIMESTAMP>>",
      "Document",
      "[1,0,0]",
      "engine_profile_parity_script",
      "Document",
      "[1,0,0]",
      5,
      5,
      5,
    ],
    "sql": "WITH 
    cte_d AS NOT MATERIALIZED (
      SELECT id AS d_id, kind AS d_kind
      FROM "typegraph_nodes"
      WHERE graph_id = $1 AND kind = $2 AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= $3) AND (valid_to IS NULL OR valid_to > $4) AND 1=1
    )
  , 
    cte_embeddings AS (
      SELECT
        node_id,
        node_kind,
        distance,
        score,
        ROW_NUMBER() OVER (ORDER BY distance ASC) AS ord
      FROM (
        
        SELECT node_id, $5 AS node_kind, (1.0 - score) AS distance, score
        FROM (
      SELECT "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."node_id" AS node_id, (1 - (("tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."embedding" <=> $6::vector))) AS score
      FROM "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"
      WHERE "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."graph_id" = $7 AND "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."node_id" IN (SELECT "cte_d"."d_id" FROM "cte_d" WHERE "cte_d"."d_kind" = $8)
      ORDER BY ("tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."embedding" <=> $9::vector) ASC
      LIMIT $10
    ) AS tg_ann_src
      
        ORDER BY distance ASC
        LIMIT $11
      ) AS vec_inner
    )
   SELECT cte_d.d_id AS "d_id" FROM cte_d INNER JOIN cte_embeddings ON cte_embeddings.node_id = cte_d.d_id AND cte_embeddings.node_kind = cte_d.d_kind ORDER BY cte_embeddings.distance ASC LIMIT $12",
  },
  {
    "params": [],
    "sql": "-- COMMIT --",
  },
]
`;

