    "sql": "WITH 
    cte_d AS (
      SELECT id AS d_id, kind AS d_kind
      FROM "typegraph_nodes"
      WHERE graph_id = ? AND kind = ? AND deleted_at IS NULL AND (valid_from IS NULL OR valid_from <= ?) AND (valid_to IS NULL OR valid_to > ?) AND 1=1
    )
  , 
    cte_embeddings AS (
      SELECT
        node_id,
        node_kind,
        distance,
        score,
        ROW_NUMBER() OVER (ORDER BY distance ASC) AS ord
      FROM (
        
        SELECT node_id, ? AS node_kind, (1.0 - score) AS distance, score
        FROM (
        SELECT "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."node_id" AS node_id, (1 - (vec_distance_cosine("tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."embedding", vec_f32(?)))) AS score
        FROM "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"
        WHERE "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."embedding" MATCH vec_f32(?) AND k = ? AND "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."graph_id" = ? AND "tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."node_id" IN (SELECT "cte_d"."d_id" FROM "cte_d" WHERE "cte_d"."d_kind" = ?)
        ORDER BY distance ASC
      ) AS tg_ann_src
      
        ORDER BY distance ASC
        LIMIT ?
      ) AS vec_inner
    )
   SELECT cte_d.d_id AS "d_id" FROM cte_d INNER JOIN cte_embeddings ON cte_embeddings.node_id = cte_d.d_id AND cte_embeddings.node_kind = cte_d.d_kind ORDER BY cte_embeddings.distance ASC LIMIT ?",
  },
]
`;
