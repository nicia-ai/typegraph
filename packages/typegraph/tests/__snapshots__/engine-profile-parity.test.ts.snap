    SELECT "id" AS node_id
    FROM "typegraph_nodes"
    WHERE "graph_id" = $3
      AND "kind" = $4
      AND "deleted_at" IS NULL
      AND ("valid_from" IS NULL OR "valid_from" <= $5)
      AND ("valid_to" IS NULL OR "valid_to" > $6)
  )
      ORDER BY ("tg_vec_engine_profile_parity_script_document_embedding_74fd603b"."embedding" <=> $7::vector) ASC
      LIMIT $8
    ",
