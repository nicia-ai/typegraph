{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@nicia-ai/typegraph": ["./src/index.ts"],
      "@nicia-ai/typegraph/backend": ["./src/backend/index.ts"],
      "@nicia-ai/typegraph/core": ["./src/core/index.ts"],
      "@nicia-ai/typegraph/interchange": ["./src/interchange/index.ts"],
      "@nicia-ai/typegraph/profiler": ["./src/profiler/index.ts"],
      "@nicia-ai/typegraph/schema": ["./src/schema/index.ts"],
      "@nicia-ai/typegraph/indexes": ["./src/indexes/index.ts"],
      "@nicia-ai/typegraph/graph-extension": ["./src/graph-extension/index.ts"],
      "@nicia-ai/typegraph/graph-merge": ["./src/graph-merge/index.ts"],
      "@nicia-ai/typegraph/provenance": ["./src/provenance/index.ts"],
      "@nicia-ai/typegraph/sqlite/local": [
        "./src/backend/sqlite/local-store.ts"
      ],
      "@nicia-ai/typegraph/postgres/pglite": [
        "./src/backend/postgres/pglite-store.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/sqlite": [
        "./src/backend/sqlite/index.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/sqlite/local": [
        "./src/backend/sqlite/local.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/sqlite/libsql": [
        "./src/backend/sqlite/libsql.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/postgres": [
        "./src/backend/postgres/index.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/postgres/pglite": [
        "./src/backend/postgres/pglite.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/indexes": [
        "./src/backend/drizzle/indexes.ts"
      ],
      "@nicia-ai/typegraph/adapters/drizzle/engine": [
        "./src/backend/drizzle/engine/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples",
    "scripts",
    "tsup.config.ts",
    "type-smoke/edge-endpoint-compat.ts"
  ],
  "exclude": ["tests/do-sqlite"]
}
