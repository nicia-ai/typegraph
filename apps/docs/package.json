{
  "name": "@nicia-ai/typegraph-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#blog-art": "./scripts/lib/blog-art.mjs",
    "#generic-blog-image": "./scripts/generate-blog-images.mjs"
  },
  "scripts": {
    "predev": "node scripts/sync-changelog.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-changelog.mjs && node scripts/check-blog-images.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "pretypecheck": "node scripts/sync-changelog.mjs && node scripts/check-blog-images.mjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "check:blog-images": "node scripts/check-blog-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/starlight": "^0.42.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "astro": "^7.3.3",
    "starlight-blog": "^0.29.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@typegraph/eslint-config": "workspace:*",
    "@types/node": "^24.13.2",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  }
}
